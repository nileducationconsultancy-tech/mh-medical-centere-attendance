# ==============================================================================
# MH Medical Centre Attendance & Payroll System - Backend Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Provide your new MH Medical Centre MongoDB connection string below:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/mh_medical_db?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here

# Super Admin Bootstrap Credentials
SUPER_ADMIN_EMAIL=admin@mhmedicalcentre.com
SUPER_ADMIN_PASSWORD=YourSecureAdminPassword123!
ADMIN_NAME=Dr. Feroz

# Employee ID Configuration
EMPLOYEE_ID_PREFIX=MH-EMP-

# Timezone & Geolocation
TIMEZONE=Asia/Kolkata
GEOAPIFY_API_KEY=
OFFICE_IPS=127.0.0.1,::1

# Allowed Client URLs (CORS)
CLIENT_URL=https://mh-medical-centere-attendance-rm76.vercel.app
FRONTEND_URL=https://mh-medical-centere-attendance-rm76.vercel.app

# Email / Gmail Notification Settings (Optional / As needed)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Supabase Storage Configuration (Document Uploads & Verification)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET_NAME=Employee-document
