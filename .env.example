# ==============================================================================
# MH Medical Centre - Enterprise Attendance & Management Platform
# ==============================================================================
#
# Root Environment Template: Copy this file to Backend/.env and configure:
#

# Server & Runtime
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Provide your new MH Medical Centre MongoDB connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/mh_medical_db?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Super Admin Bootstrap Credentials
SUPER_ADMIN_EMAIL=admin@mhmedicalcentre.com
SUPER_ADMIN_PASSWORD=YourSecurePassword123!
ADMIN_NAME=Dr. Feroz

# Automatic Employee ID Prefix
EMPLOYEE_ID_PREFIX=MH-EMP-

# Timezone & Geolocation
TIMEZONE=Asia/Kolkata
GEOAPIFY_API_KEY=
OFFICE_IPS=127.0.0.1,::1

# Allowed Client URLs (CORS)
CLIENT_URL=https://mh-medical-centere-attendance-rm76.vercel.app
FRONTEND_URL=https://mh-medical-centere-attendance-rm76.vercel.app

# Email / Gmail Notification Settings (Optional)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Supabase Storage Configuration (Optional Cloud Document Storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET_NAME=Employee-document
